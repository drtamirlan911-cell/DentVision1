#!/usr/bin/env bash
echo "🔍 Pre-commit: TypeScript check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Fix before committing."
  exit 1
fi
echo "✅ TypeScript check passed"

echo "🔍 Pre-commit: Lint check..."
npx eslint src/ --max-warnings 10000
if [ $? -ne 0 ]; then
  echo "❌ Lint errors found. Fix before committing."
  exit 1
fi
echo "✅ Lint check passed"

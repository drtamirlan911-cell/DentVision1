# Скопируйте в android/keystore.properties (файл в .gitignore, в репозиторий
# не попадает) и заполните реальными значениями, либо задайте те же имена
# как переменные окружения в CI (RELEASE_STORE_FILE, RELEASE_STORE_PASSWORD,
# RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD) — build.gradle.kts проверяет файл,
# затем окружение, и без обоих `release` останется неподписанным, как раньше.
#
# Собственный ключ создаётся один раз:
#   keytool -genkeypair -v -keystore dentvision-release.jks -alias dentvision \
#     -keyalg RSA -keysize 2048 -validity 10000
# Храните .jks и пароли отдельно от репозитория — файл теряется, старый APK
# на Google Play больше нельзя обновить тем же ключом.

storeFile=/absolute/path/to/dentvision-release.jks
storePassword=CHANGE_ME
keyAlias=dentvision
keyPassword=CHANGE_ME

<?xml version="1.0" encoding="utf-8"?>
<!--
  Токены доступа и данные сессии не покидают устройство: ни облачный бэкап,
  ни перенос на новое устройство их не забирают.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>

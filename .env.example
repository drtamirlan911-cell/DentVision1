# Frontend environment (Vite). Copy to `.env.local` for development; set the
# same keys in the Vercel project for production.
#
# Everything here ships to the browser — `VITE_` variables are inlined into the
# bundle at build time. Never put a secret in this file.

# Backend origin. Defaults to https://dentvision-api.onrender.com on a Vercel
# host and http://localhost:3001 otherwise, so this is only needed to point a
# local frontend at a different API.
VITE_API_URL=

# Google sign-in. The same client id the backend gets as GOOGLE_CLIENT_ID —
# it is public by design. Create it in Google Cloud Console → Credentials →
# OAuth client ID (type: Web) and list every origin the app is served from
# under "Authorized JavaScript origins":
#   https://dent-vision1.vercel.app
#   http://localhost:5173
# There is no client secret: the ID-token flow does not use one.
#
# Leave it empty and the Google button simply does not render — sign-in by
# email and password is unaffected.
VITE_GOOGLE_CLIENT_ID=

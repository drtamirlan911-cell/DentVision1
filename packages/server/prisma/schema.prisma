generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLINIC_OWNER
  DOCTOR
  ASSISTANT
  MANAGER
  RECEPTIONIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AIActionCategory {
  NAVIGATION
  PATIENT_MANAGEMENT
  APPOINTMENT_MANAGEMENT
  TREATMENT_PLANNING
  FINANCIAL
  INVENTORY
  ANALYTICS
  KNOWLEDGE
  COMMUNICATION
  SETTINGS
}

enum KnowledgeSourceType {
  OFFICIAL_GUIDELINES
  CLINICAL_PROTOCOLS
  DRUG_DATABASE
  EQUIPMENT_MANUALS
  INTERNAL_WIKI
  COMMUNITY
  AI_GENERATED
}

enum ProactiveTriggerType {
  SCHEDULE_CONFLICT
  TREATMENT_DEADLINE
  INVENTORY_LOW
  FINANCIAL_ALERT
  PATIENT_FOLLOWUP
  EQUIPMENT_MAINTENANCE
  COMPLIANCE_REMINDER
  LEARNING_OPPORTUNITY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatar        String?
  role          UserRole  @default(DOCTOR)
  status        UserStatus @default(ACTIVE)
  phone         String?
  specialization String?
  licenseNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  clinicId      String?
  clinic        Clinic?   @relation(fields: [clinicId], references: [id])

  memberships   ClinicMembership[]
  ownedClinics  Clinic[]  @relation("ClinicOwner")
  aiContext     AIUserContext?
  aiConversations AIConversation[]
  aiActions     AIActionLog[]
  proactiveAlerts ProactiveAlert[]

  @@index([clinicId])
  @@index([email])
  @@index([role])
}

model Clinic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  address     String?
  phone       String?
  email       String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  language    String   @default("en")
  plan        String   @default("free")
  settings    Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String
  owner       User     @relation("ClinicOwner", fields: [ownerId], references: [id])

  memberships ClinicMembership[]
  patients    Patient[]
  appointments Appointment[]
  treatments  Treatment[]
  inventory   InventoryItem[]
  aiContext   AIClinicContext?
  aiKnowledge AIKnowledgeBase[]

  @@index([slug])
  @@index([ownerId])
}

model ClinicMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role      UserRole @default(DOCTOR)
  permissions Json   @default("{}")
  joinedAt  DateTime @default(now())
  invitedBy String?
  isActive  Boolean  @default(true)

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@index([userId])
}

model Patient {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  middleName   String?
  email        String?
  phone        String?
  dateOfBirth  DateTime?
  gender       String?
  address      String?
  emergencyContact Json?
  medicalHistory String?
  allergies    String?
  medications  String?
  notes        String?
  avatar       String?
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  appointments Appointment[]
  treatments   Treatment[]
  aiContext    AIPatientContext?

  @@index([clinicId])
  @@index([email])
  @@index([phone])
  @@index([lastName, firstName])
}

model Appointment {
  id          String           @id @default(cuid())
  patientId   String
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      User             @relation(fields: [doctorId], references: [id])
  clinicId    String
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(SCHEDULED)
  type        String?
  notes       String?
  color       String?
  isRecurring Boolean          @default(false)
  recurrenceRule String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  treatments  Treatment[]

  @@index([clinicId, startTime])
  @@index([doctorId, startTime])
  @@index([patientId])
  @@index([status])
}

model Treatment {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      User            @relation(fields: [doctorId], references: [id])
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  tooth       String?
  surface     String?
  diagnosis   String?
  procedure   String
  status      TreatmentStatus @default(PLANNED)
  plan        String?
  notes       String?
  cost        Decimal         @default(0)
  paid        Decimal         @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model InventoryItem {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  category    String
  unit        String
  quantity    Int      @default(0)
  minQuantity Int      @default(10)
  maxQuantity Int?
  unitCost    Decimal  @default(0)
  supplier    String?
  location    String?
  expiryDate  DateTime?
  batchNumber String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clinicId, sku])
  @@index([clinicId])
  @@index([category])
}

model AIUserContext {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences     Json     @default("{}")
  recentPatients  String[] @default([])
  recentActions   Json     @default("[]")
  skillLevel      Json     @default("{}")
  workingHours    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AIClinicContext {
  id              String   @id @default(cuid())
  clinicId        String   @unique
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  protocols       Json     @default("[]")
  equipment       Json     @default("[]")
  materials       Json     @default("[]")
  pricing         Json     @default("{}")
  workflows       Json     @default("[]")
  complianceRules Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AIPatientContext {
  id              String   @id @default(cuid())
  patientId       String   @unique
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentHistory Json    @default("[]")
  preferences     Json     @default("{}")
  riskFactors     Json     @default("[]")
  communicationStyle Json  @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AIConversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId    String
  title       String?
  context     Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    AIMessage[]
}

model AIMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String
  content         String
  metadata        Json     @default("{}")
  tokensUsed      Int?
  model           String?
  createdAt       DateTime @default(now())

  @@index([conversationId])
}

model AIActionLog {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId    String
  category    AIActionCategory
  action      String
  parameters  Json          @default("{}")
  result      Json?
  status      String        @default("pending")
  error       String?
  executedAt  DateTime      @default(now())
  completedAt DateTime?

  @@index([userId, executedAt])
  @@index([clinicId, executedAt])
  @@index([category])
}

model AIKnowledgeBase {
  id          String            @id @default(cuid())
  clinicId    String
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  title       String
  content     String
  sourceType  KnowledgeSourceType
  sourceUrl   String?
  tags        String[]
  category    String
  language    String            @default("en")
  version     String            @default("1.0")
  isActive    Boolean           @default(true)
  isVerified  Boolean           @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clinicId, category])
  @@index([clinicId, isActive])
  @@index([tags])
}

model ProactiveAlert {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId    String
  triggerType ProactiveTriggerType
  title       String
  message     String
  priority    Int                 @default(1)
  data        Json                @default("{}")
  actionUrl   String?
  isRead      Boolean             @default(false)
  isDismissed Boolean             @default(false)
  createdAt   DateTime            @default(now())
  readAt      DateTime?
  dismissedAt DateTime?

  @@index([userId, isRead, isDismissed])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  clinicId  String
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}
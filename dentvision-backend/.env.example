DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dentvision?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production-$(openssl rand -hex 32)"
JWT_REFRESH_SECRET="change-me-refresh-$(openssl rand -hex 32)"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
ENCRYPTION_KEY=""

# AI / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_MODEL_MODE=auto
OPENAI_DAILY_MINI_TOKENS=2400000
OPENAI_DAILY_FULL_TOKENS=240000
OPENAI_REASONING_EFFORT=low

# Email (password reset, patient portal links).
# SMTP_PASSWORD is a Google App Password — 16 characters, generated at
# https://myaccount.google.com/apppasswords after enabling 2-Step Verification.
# An ordinary account password will be rejected by Gmail's SMTP server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dentvision.kz@gmail.com
SMTP_PASSWORD=
EMAIL_FROM="DentVision <dentvision.kz@gmail.com>"

# Google sign-in. The client id is public and also ships to the browser as
# VITE_GOOGLE_CLIENT_ID; there is no client secret in the ID-token flow.
GOOGLE_CLIENT_ID=
# Development only: points the token verifier at a local certificate endpoint so
# the sign-in route can be exercised without a real Google account. Ignored when
# NODE_ENV=production — the signing keys are the entire trust anchor.
GOOGLE_CERTS_URL=

# Twilio (SMS / WhatsApp notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Cron
CRON_SECRET=

# Platform Operations
PLATFORM_OPS_SECRET=

# Payments — Kaspi Pay (https://pay.kaspi.kz)
# Получить в личном кабинете Kaspi Business → Настройки → API
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_CALLBACK_SECRET=
KASPI_PAY_BASE_URL=https://pay.kaspi.kz/pay

# Webhooks
PUBLIC_API_URL=

# Reminders
REMINDER_CRON_MS=900000

# Meta / WhatsApp / Instagram webhooks
META_APP_SECRET=
META_APP_ID=
META_WEBHOOK_VERIFY_TOKEN=

# AI Admin
AI_ADMIN_MAX_HISTORY=20

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Demo / Seed
SEED_SECRET=
DEMO_CLINIC_ID=
DEMO_USER_PASSWORD=
LOCK_DEMO_ACCOUNTS=false

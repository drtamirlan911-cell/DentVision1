// --- FINANCE (Phase 4) ---

enum WalletOwnerType {
  CLINIC
  SUPPLIER
  ACADEMY
  LECTURER
  PARTNER
  PLATFORM
  GATEWAY
  USER
}

enum CashbackScope {
  ALL
  CATEGORY
  PRODUCT
  OWN_BRAND
}

enum TxStatus {
  pending
  completed
  failed
  reversed
}

model Wallet {
  id        String          @id @default(uuid())
  ownerType WalletOwnerType
  ownerId   String
  currency  String          @default("KZT")
  balance   BigInt          @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  ledgerEntries LedgerEntry[]
  payouts       Payout[]

  @@unique([ownerType, ownerId, currency])
  @@map("wallets")
}

model Transaction {
  id       String   @id @default(uuid())
  type     String
  status   TxStatus @default(completed)
  amount   BigInt
  currency String   @default("KZT")
  refType  String?
  refId    String?
  meta     Json?

  ledgerEntries LedgerEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([refType, refId])
  @@map("transactions")
}

model LedgerEntry {
  id            String @id @default(uuid())
  transactionId String
  walletId      String
  direction     String
  amount        BigInt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([walletId])
  @@index([transactionId])
  @@map("ledger_entries")
}

model CommissionRule {
  id         String   @id @default(uuid())
  domain     String
  scopeId    String?
  percentBps Int
  splitJson  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([domain, scopeId])
  @@map("commission_rules")
}

// --- PAYMENTS (Phase 5) ---

model Payment {
  id         String          @id @default(uuid())
  provider   PaymentProvider @default(kaspi)
  externalId String?         @unique
  amount     BigInt
  currency   String          @default("KZT")
  status     PaymentStatus   @default(pending)
  refType    String?
  refId      String?
  domain     String?
  sellerType String?
  sellerId   String?
  meta       Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([refType, refId])
  @@map("payments")
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  paymentId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@map("idempotency_records")
}

model Subscription {
  id        String          @id @default(uuid())
  ownerType WalletOwnerType
  ownerId   String
  plan      String          @default("free")
  status    String          @default("active")
  periodEnd DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([ownerType, ownerId])
  @@map("subscriptions")
}

model Payout {
  id       String @id @default(uuid())
  walletId String
  amount   BigInt
  status   String @default("requested")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([walletId])
  @@map("payouts")
}

model Dispute {
  id        String    @id @default(uuid())
  refType   String
  refId     String
  reason    String
  status    String    @default("open")
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([refType, refId])
  @@map("disputes")
}

// --- DENT CASHBACK ---

model CashbackRule {
  id        String          @id @default(uuid())
  ownerType WalletOwnerType
  ownerId   String
  scope     CashbackScope   @default(ALL)
  scopeKey  String?
  rateBps   Int
  capMinor  BigInt?
  active    Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([ownerType, ownerId, active])
  @@index([scope, scopeKey])
  @@map("cashback_rules")
}

model DentCashLedger {
  id          String    @id @default(uuid())
  userId      String
  type        String
  status      String    @default("pending")
  amountMinor BigInt
  currency    String    @default("KZT")
  refType     String?
  refId       String?
  sellerType  String?
  sellerId    String?
  meta        Json?
  availableAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId, status])
  @@index([refType, refId])
  @@map("dentcash_ledger")
}

// --- COMPLIANCE (Phase 7) ---

model ComplianceCheck {
  id         String @id @default(uuid())
  entityType String
  entityId   String
  status     String @default("needs_review")
  findings   Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([entityType, entityId])
  @@map("compliance_checks")
}


model DeveloperApp {
  id          String   @id @default(uuid())
  ownerUserId String
  name        String
  environment String   @default("sandbox")
  scopes      String[]

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  apiKeys  ApiKey[]
  webhooks Webhook[]

  @@index([ownerUserId])
  @@map("developer_apps")
}

model ApiKey {
  id        String    @id @default(uuid())
  appId     String
  prefix    String    @unique
  hash      String
  scopes    String[]
  rateLimit Int       @default(200)
  revokedAt DateTime?

  app DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([appId])
  @@map("api_keys")
}

model Webhook {
  id     String   @id @default(uuid())
  appId  String
  url    String
  events String[]
  secret String

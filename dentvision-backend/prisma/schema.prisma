// ─── UNIVERSAL ORGANIZATION / PERSON / IAM v2 ───

model Organization {
  id       String  @id @default(uuid())
  name     String
  type     String // CLINIC | ACADEMY | LABORATORY | DIAGNOSTIC_CENTER | SUPPLIER_COMPANY | PARTNER
  taxId    String?
  address  String?
  phone    String?
  email    String?
  logo     String?
  contacts Json?
  settings Json? // type-specific settings (plan, courses config, delivery config, etc.)

  // Link back to original table for backward compatibility during migration
  originalType String? // 'Clinic' | 'Supplier' | 'Academy' | 'DiagnosticCenter' | 'Laboratory' | 'Partner'
  originalId   String? // ID in the original table

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  persons     Person[]
  invitations OrganizationInvitation[]

  @@unique([originalType, originalId])
  @@index([type])
  @@index([name])
  @@map("organizations")
}

/// Invite code letting a user join an organization that is not a clinic.
///
/// `ClinicInvitation` covers clinics only, so a diagnostic centre or laboratory
/// had no way to gain a second member at all: `diagnostic_center_members` rows
/// were only ever written by `grantDiagnosticsAccess` when a superadmin
/// approved the founding registration request. This is the clinic invitation's
/// shape, keyed on `Organization` so the same mechanism serves suppliers and
/// the academy later without another table.
model OrganizationInvitation {
  id             String    @id @default(uuid())
  organizationId String
  /// Restricts the invite to one address when set; any signed-in user may use
  /// it when null.
  email          String?
  /// Role inside the organization, in that organization's own vocabulary —
  /// for diagnostics: admin | manager | radiologist | operator.
  role           String
  code           String    @unique
  expiresAt      DateTime?
  usedAt         DateTime?
  usedBy         String?
  createdBy      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([organizationId])
  @@map("organization_invitations")
}

model Person {
  id             String  @id @default(uuid())
  fullName       String
  personType     String // DOCTOR | LECTURER | SELLER | SUPPLIER_REP | STAFF | OPERATOR | RADIOLOGIST
  organizationId String? @map("organization_id")
  // Optional link to a platform User. Unique *per organization*, not globally:
  // one user legitimately belongs to several organizations (a doctor working in
  // two clinics, a clinic owner who also runs a laboratory), and a global
  // unique made the unified model unable to represent that at all.
  userId         String?
  phone          String?
  email          String?
  specialization String?
  bio            String?
  avatar         String?
  contacts       Json?

  // Link back to original table for backward compatibility
  originalType String? // 'User' | 'Lecturer' | 'SupplierMember' | 'DiagnosticCenterMember' | etc.
  originalId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  personRoles  PersonRole[]
  compensation PersonCompensation?

  @@unique([originalType, originalId])
  @@unique([userId, organizationId])
  @@index([personType])
  @@index([organizationId])
  @@index([userId])
  @@map("persons")
}

/// Payroll configuration for a staff member, in the unified model.
///
/// These three fields lived only on ClinicMember, so staff that exist only as a
/// Person had no payroll configuration at all — /billing/my-payroll answered 404
/// and the clinic payroll run skipped them. Person is the right anchor: since
/// the multi-org migration there is exactly one per (user, organization), which
/// is precisely what a membership is.
model PersonCompensation {
  id                String @id @default(uuid())
  personId          String @unique
  commissionPercent Int    @default(30)
  baseSalary        Int    @default(0)
  payType           String @default("commission") // commission | salary | mixed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("person_compensation")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. 'patients:read', 'appointments:write'
  name        String
  description String?
  domain      String // 'crm' | 'finance' | 'settings' | 'admin' | 'ai' | etc.

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@map("permissions")
}

model Role {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. 'org_admin', 'doctor', 'lecturer', 'seller'
  name        String
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted

  permissions RolePermission[]

  createdAt   DateTime     @default(now())
  personRoles PersonRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PersonRole {
  id        String  @id @default(uuid())
  personId  String
  roleId    String
  scopeType String? // 'organization' | 'platform' | null
  scopeId   String? // organization ID if scoped

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([personId, roleId])
  @@index([personId])
  @@index([roleId])
  @@map("person_roles")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

/// Governance kernel (Agentic OS §6/§8/§12): one row per tool invocation the
/// AI kernel (`ai/os/kernel.ts::runAiAction`) attempts — allowed, denied, or
/// executed. `actorUserId` deliberately carries no relation to `User`: the
/// ai-admin surface acts under a synthetic id ('system:ai-admin:<sessionId>')
/// that has no row in that table, so a hard FK would be wrong for this table.
model AgentActivity {
  id             String   @id @default(uuid())
  traceId        String?
  surface        String
  agentId        String?
  tool           String
  actorUserId    String
  actorRole      String
  clinicId       String?
  organizationId String?
  patientId      String?
  teamKey        String?
  visibility     String   @default("clinic")
  sensitivity    String   @default("standard")
  status         String
  denyReason     String?
  argsRedacted   Json?
  resultSummary  String?
  durationMs     Int?
  approvalId     String?
  createdAt      DateTime @default(now())

  evidence ActionEvidence[]

  @@index([clinicId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([teamKey, createdAt])
  @@index([organizationId, createdAt])
  @@index([patientId])
  @@map("agent_activities")
}

/// Observable evidence for one `AgentActivity` row — never chain-of-thought,
/// only what was actually read or written (Agentic OS §6).
/**
 * Content-addressed cache of text embeddings.
 * Same idea as `VoiceAsset`: the same text embedded by the same model always
 * yields the same vector, so paying for it twice is waste. Keyed by a hash of
 * (model + text), which also means a model change simply misses the cache
 * rather than silently mixing vectors from two different spaces — comparing
 * those would produce confident nonsense.
 */
model EmbeddingCache {
  id        String   @id @default(uuid())
  /**
   * sha256 of `${model}|${text}`.
   */
  hash      String   @unique
  model     String
  /**
   * The vector itself. Postgres float8[] — no extension required.
   */
  vector    Float[]
  dimension Int
  createdAt DateTime @default(now())

  @@index([model])
  @@map("embedding_cache")
}

model ActionEvidence {
  id         String   @id @default(uuid())
  activityId String
  sourceType String
  sourceId   String
  access     String?
  clinicId   String?
  snapshot   Json?
  createdAt  DateTime @default(now())

  activity AgentActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("action_evidence")
}

/// Human-in-the-loop queue (Agentic OS §7) for high-risk kernel actions
/// (`ai/os/dataScope.ts::HIGH_RISK_TOOLS`). A row here survives a page
/// refresh and can be acted on by any authorized colleague, not only the
/// browser tab that triggered it — unlike the old `needsConfirmation`
/// round-trip, which lived only in client state.
model AiApproval {
  id                 String    @id @default(uuid())
  clinicId           String?
  organizationId     String?
  requestedByUserId  String
  surface            String
  agentId            String?
  tool               String
  params             Json
  summary            String
  requiredPermission String?
  riskLevel          String    @default("standard")
  status             String    @default("pending")
  decidedByUserId    String?
  decidedAt          DateTime?
  decisionNote       String?
  resultActivityId   String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([clinicId, status, createdAt])
  @@index([status, expiresAt])
  @@map("ai_approvals")
}

/// AI-only patient scope (Stage 6, `env.AI_PATIENT_SCOPE`). Backfilled from
/// distinct `(clinicId, patientId, doctorId)` triples in `Appointment` —
/// human REST/UI access to patients is deliberately left unaffected by this
/// model; only the kernel's patient-scope check (`kernel.ts` step 5) reads it.
model PatientAssignment {
  id        String    @id @default(uuid())
  clinicId  String
  patientId String
  userId    String
  /// 'treating_doctor' | 'assistant' | 'coordinator'
  role      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([patientId, userId, role])
  @@index([clinicId, userId, active])
  @@index([patientId, active])
  @@map("patient_assignments")
}

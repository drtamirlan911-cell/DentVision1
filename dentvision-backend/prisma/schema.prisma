// в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
// DentVision Diagnostics
// в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ

enum DiagnosticCategory {
  CBCT
  OPG
  TRG
  TMJ
  STL
  FACE_SCAN
  DICOM
  ALLERGY
  HISTOLOGY
  PCR
  MICROBIOLOGY
  BLOOD
  GENETICS
  BIOPSY
  SALIVA
  PATHOLOGY
  OTHER
}

enum ReferralStatus {
  DRAFT
  SENT
  ACCEPTED
  SCHEDULED
  PATIENT_ARRIVED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  DELIVERED
  CLOSED
  CANCELLED
}

enum ReferralPriority {
  NORMAL
  URGENT
  EMERGENCY
}

model DiagnosticCenter {
  id         String   @id @default(uuid())
  name       String
  city       String?
  address    String?
  phone      String?
  email      String?
  rating     Float?   @default(0)
  logo       String?
  lat        Float?
  lng        Float?
  active     Boolean  @default(true)
  accredited Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members      DiagnosticCenterMember[]
  referrals    Referral[]               @relation("CenterReferral")
  studies      DiagnosticStudy[]
  operators    Operator[]
  radiologists Radiologist[]
  bookings     DiagnosticBooking[]
  schedules    Schedule[]

  @@map("diagnostic_centers")
}

model DiagnosticCenterMember {
  id        String   @id @default(uuid())
  centerId  String
  userId    String
  role      String // admin | radiologist | operator | manager
  createdAt DateTime @default(now())

  center DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([centerId, userId])
  @@index([userId])
  @@map("diagnostic_center_members")
}

model Laboratory {
  id         String   @id @default(uuid())
  name       String
  city       String?
  address    String?
  phone      String?
  email      String?
  rating     Float?   @default(0)
  accredited Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members   LaboratoryMember[]
  referrals Referral[]          @relation("LabReferral")
  tests     LaboratoryTest[]
  bookings  DiagnosticBooking[]

  @@map("laboratories")
}

model LaboratoryMember {
  id        String   @id @default(uuid())
  labId     String
  userId    String
  role      String
  createdAt DateTime @default(now())

  lab  Laboratory @relation(fields: [labId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([labId, userId])
  @@index([userId])
  @@map("laboratory_members")
}

model DiagnosticStudy {
  id          String             @id @default(uuid())
  centerId    String
  name        String // CBCT, OPG, TRG, etc.
  category    DiagnosticCategory
  description String?
  price       Decimal?           @default(0)
  durationMin Int?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())

  center   DiagnosticCenter    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  bookings DiagnosticBooking[]

  @@index([centerId])
  @@index([category])
  @@map("diagnostic_studies")
}

model LaboratoryTest {
  id           String             @id @default(uuid())
  labId        String
  name         String
  category     DiagnosticCategory
  description  String?
  price        Decimal?           @default(0)
  turnaroundHr Int?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())

  lab Laboratory @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([category])
  @@map("laboratory_tests")
}

model Operator {
  id        String   @id @default(uuid())
  centerId  String
  userId    String
  specialty String? // CBCT, OPG, etc.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  center    DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([centerId])
  @@map("operators")
}

model Radiologist {
  id        String   @id @default(uuid())
  centerId  String
  userId    String
  specialty String? // 3D, general
  license   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  center    DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([centerId])
  @@map("radiologists")
}

model Referral {
  id               String             @id @default(uuid())
  // Patient info (snapshot at time of referral)
  patientId        String?
  patientName      String
  patientIin       String?
  patientBirth     DateTime?
  patientAge       Int?
  patientGender    String?
  patientPhone     String?
  patientEmail     String?
  pregnancy        Boolean            @default(false)
  allergies        String?
  specialNotes     String?
  patientPhoto     String?
  // Doctor info
  clinicId         String
  doctorId         String
  doctorName       String?
  doctorPhone      String?
  doctorEmail      String?
  // Diagnostic type
  category         DiagnosticCategory
  studyType        String // specific: CBCT, OPG, Histology, Allergy, etc.
  anatomicalSites  Json? // selected teeth/regions [{region, teeth[]}]
  // Clinical
  complaints       String?
  preliminaryDx    String?
  studyGoal        String?
  commentForDoctor String?
  commentForLab    String?
  priority         ReferralPriority   @default(NORMAL)
  status           ReferralStatus     @default(DRAFT)
  // Assignment
  centerId         String?
  labId            String?
  operatorId       String?
  radiologistId    String?
  // Schedule
  scheduledDate    DateTime?
  scheduledTime    String?
  // Finance
  cost             Decimal?           @default(0)
  platformFee      Decimal?           @default(0)
  paid             Boolean            @default(false)
  paidAt           DateTime?
  // Platform settlement: once a paid referral's platformFee is rolled into a
  // Settlement, this links it so it can never be counted twice.
  settlementId     String?
  // Audit
  reviewerId       String?
  reviewedAt       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  clinic      Clinic            @relation(fields: [clinicId], references: [id])
  doctor      User              @relation(fields: [doctorId], references: [id])
  patient     Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  center      DiagnosticCenter? @relation("CenterReferral", fields: [centerId], references: [id])
  lab         Laboratory?       @relation("LabReferral", fields: [labId], references: [id])
  operator    Operator?         @relation(fields: [operatorId], references: [id])
  radiologist Radiologist?      @relation(fields: [radiologistId], references: [id])
  reviewer    User?             @relation("ReferralReviewer", fields: [reviewerId], references: [id])
  files       ReferralFile[]
  comments    ReferralComment[]
  result      DiagnosticResult?
  settlement  Settlement?       @relation("SettlementReferrals", fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([centerId])
  @@index([labId])
  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@index([settlementId])
  @@map("referrals")
}

/// Periodic platform-commission settlement owed by a diagnostic center / lab.
/// Patients pay the center directly; the platform collects its accrued
/// `Referral.platformFee` from the center via these settlements.
model Settlement {
  id              String    @id @default(uuid())
  ownerType       String // 'CENTER' | 'LAB'
  ownerId         String
  periodStart     DateTime
  periodEnd       DateTime
  referralCount   Int       @default(0)
  /// Total commission for the period, in minor units (тиын).
  commissionMinor BigInt    @default(0)
  status          String    @default("open") // open | invoiced | paid | void
  paymentId       String?
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  referrals Referral[] @relation("SettlementReferrals")

  @@index([ownerType, ownerId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("settlements")
}

model ReferralFile {
  id         String   @id @default(uuid())
  referralId String
  fileName   String
  fileType   String // image|pdf|dicom|stl|zip
  fileUrl    String
  fileSize   Int?
  uploadedBy String
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id])

  @@index([referralId])
  @@map("referral_files")
}

model ReferralComment {
  id         String   @id @default(uuid())
  referralId String
  authorId   String
  text       String
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([referralId])
  @@map("referral_comments")
}

model DiagnosticResult {
  id          String    @id @default(uuid())
  referralId  String    @unique
  reportText  String? // Rich text / HTML
  conclusion  String?
  pdfUrl      String?
  signedBy    String?
  signedAt    DateTime?
  aiSummary   String?
  aiGenerated Boolean   @default(false)
  /**
   * Whether the AI pass actually looked at the attached study.
   * It used to describe "находки" for a radiograph it was never sent, so a
   * reader had no way to tell a report grounded in an image from one composed
   * out of the referral's free text. False also covers a refusal: no consent,
   * no file, no vision-capable model.
   */
  aiSawSource Boolean   @default(false)
  templateId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  signer   User?    @relation(fields: [signedBy], references: [id])

  @@map("diagnostic_results")
}

model DiagnosticBooking {

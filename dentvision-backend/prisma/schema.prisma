enum PartnerType {
  MANUFACTURER
  DISTRIBUTOR
  ACADEMY
  LABORATORY
  OFFICIAL_PARTNER
  CLINIC
  DIAGNOSTIC_CENTER
  SUPPLIER
  LECTURER
  EDUCATION_CENTER
  RESELLER
  CORPORATE
}

model Partner {
  id      String      @id @default(uuid())
  type    PartnerType
  refType String
  refId   String
  tierId  String?
  status  String      @default("active")

  tier      PartnerTier?        @relation(fields: [tierId], references: [id], onDelete: SetNull)
  kpis      PartnerKPI[]
  slas      PartnerSLA[]
  campaigns MarketingCampaign[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([type, status])

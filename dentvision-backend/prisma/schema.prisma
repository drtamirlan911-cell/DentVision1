generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserRole {
  OWNER
  DOCTOR
  ASSISTANT
  ADMIN
  CASHIER
  LAB
  MANAGER
  STUDENT
  SUPERADMIN
  SUPPORT
}

enum ClinicPlan {
  DEMO
  STANDARD
  PRO
  ENTERPRISE
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum InvoiceStatus {
  paid
  unpaid
  partial
  refund
  pending
  overdue
}

enum ImageType {
  PHOTO
  X_RAY
  CBCT
  DICOM
  SCAN
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum WaitingListStatus {
  waiting
  called
  cancelled
}

enum PlanStatus {
  draft
  active
  completed
  cancelled
  proposed
  accepted
  in_progress
}

enum LabOrderStatus {
  pending
  in_progress
  completed
  cancelled
  delivered
}

enum ActionStatus {
  pending
  completed
  failed
  cancelled
}

enum NotificationType {
  info
  warning
  error
  appointment
  promotion
  system
  subscription
  workflow
}

enum PaymentProvider {
  kaspi
  card
  cash
  other
  kaspi_qr
  clinic_kaspi
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  created
  expired
}

// --- USER SYSTEM ---

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  avatar      String?
  phone       String?
  spec        String?
  profileMeta Json?
  role        UserRole @default(DOCTOR)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  memberships                   ClinicMember[]
  aiSessions                    AISession[]
  notifications                 Notification[]
  aiActions                     AIAction[]
  aiAlerts                      AIAlert[]
  orders                        Order[]
  enrollments                   SchoolEnrollment[]
  appointments                  Appointment[]
  academies                     Academy[]
  aiMessages                    AIMessage[]
  communityPosts                CommunityPost[]
  communityLikes                CommunityLike[]
  communityComments             CommunityComment[]
  communitySaves                CommunitySave[]
  dmParticipants                DmParticipant[]
  dmMessages                    DmMessage[]
  favorites                     Favorite[]
  reviews                       ShopReview[]
  dentCashLedgers               DentCashLedger[]
  developerApps                 DeveloperApp[]
  userSessions                  UserSession[]
  consents                      Consent[]
  uploadedMedicalFiles          MedicalFileAccess[]      @relation("UploadedFiles")
  viewedMedicalFiles            MedicalFileAccess[]      @relation("ViewedFiles")
  downloadedMedicalFiles        MedicalFileAccess[]      @relation("DownloadedFiles")
  passwordResets                PasswordReset[]
  patients                      Patient[]
  aiActionLogs                  AIActionLog[]            @relation("UserActions")
  confirmedAiActions            AIActionLog[]            @relation("ConfirmedActions")
  jobVacancies                  JobVacancy[]
  jobApplications               JobApplication[]
  diagnosticReferrals           Referral[]
  reviewedReferrals             Referral[]               @relation("ReferralReviewer")
  uploadedReferralFiles         ReferralFile[]
  referralComments              ReferralComment[]
  signedResults                 DiagnosticResult[]
  diagnosticCenterMembers       DiagnosticCenterMember[]
  laboratoryMembers             LaboratoryMember[]
  operators                     Operator[]
  radiologists                  Radiologist[]
  legalTemplatesCreated         LegalTemplate[]          @relation("TemplateCreator")
  legalTemplateVersionsCreated  LegalTemplateVersion[]   @relation("VersionCreator")
  legalTemplateVersionsApproved LegalTemplateVersion[]   @relation("VersionApprover")
  legalBlocksCreated            LegalBlock[]             @relation("BlockCreator")
  legalPartnersCreated          LegalPartner[]           @relation("PartnerCreator")
  legalPartnerUser              LegalPartner?            @relation
  legalDocumentsCreated         LegalDocument[]          @relation("DocCreator")
  legalDocumentsApproved        LegalDocument[]          @relation("DocApprover")
  legalDocumentVersionsCreated  LegalDocumentVersion[]   @relation("DocVersionCreator")
  legalAuditLogs                LegalAuditLog[]
  legalInvoicesCreated          LegalInvoice[]

  @@map("users")
}

model Clinic {
  id       String     @id @default(uuid())
  name     String
  city     String?
  address  String?
  phone    String?
  logo     String?
  plan     ClinicPlan @default(DEMO)
  active   Boolean    @default(true)
  settings Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  members             ClinicMember[]
  invitations         ClinicInvitation[]
  patients            Patient[]
  appointments        Appointment[]
  labOrders           LabOrder[]
  invoices            Invoice[]
  inventory           InventoryItem[]
  orders              Order[]
  waitingList         WaitingList[]
  expenses            Expense[]
  promotions          Promotion[]
  priceList           PriceListItem[]
  reminderLogs        ReminderLog[]
  chairs              Chair[]
  bookings            Booking[]
  documents           Document[]
  aiMessages          AIMessage[]
  jobVacancies        JobVacancy[]
  customerMetrics     CustomerMetrics[]
  serviceAccesses     ServiceAccess[]
  diagnosticReferrals Referral[]

  reviews ShopReview[]

  @@map("clinics")
}

model Booking {
  id          String        @id @default(uuid())
  clinicId    String
  patientName String
  phone       String
  email       String?
  doctorId    String?
  doctorName  String?
  serviceName String?
  date        DateTime      @db.Date
  time        String
  notes       String?
  status      BookingStatus @default(pending)
  source      String        @default("online")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, status, date])
  @@map("bookings")
}

model ClinicMember {
  id                String   @id @default(uuid())
  userId            String
  clinicId          String
  role              UserRole @default(DOCTOR)
  commissionPercent Int      @default(30)
  baseSalary        Int      @default(0)
  payType           String   @default("commission")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  joinedAt  DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("clinic_members")
}

model ClinicInvitation {
  id        String    @id @default(uuid())
  clinicId  String
  email     String?
  role      UserRole  @default(DOCTOR)
  code      String    @unique
  expiresAt DateTime?
  usedAt    DateTime?
  usedBy    String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@map("clinic_invitations")
}

// --- PATIENT CRM ---

model Patient {
  id             String    @id @default(uuid())
  clinicId       String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  birthDate      DateTime?
  gender         String?
  address        String?
  notes          String?
  iin            String?
  medicalHistory Json?
  prepaidBalance Int       @default(0)
  deletedAt      DateTime?
  userId         String?

  clinic              Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits              Visit[]
  appointments        Appointment[]
  teeth               Tooth[]
  treatmentPlans      TreatmentPlan[]
  images              PatientImage[]
  documents           Document[]
  labOrders           LabOrder[]
  invoices            Invoice[]
  aiActionLogs        AIActionLog[]
  medicalFileAccesses MedicalFileAccess[]
  diagnosticReferrals Referral[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@map("patients")
}

// --- APPOINTMENTS ---

model Appointment {
  id        String            @id @default(uuid())
  clinicId  String
  patientId String
  doctorId  String
  date      DateTime
  time      String?
  duration  Int?              @default(30)
  status    AppointmentStatus @default(pending)
  type      String?
  notes     String?
  meta      Json?

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User    @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, date])
  @@index([doctorId, date])
  @@map("appointments")
}

// --- CRM OPS ---

model WaitingList {
  id               String            @id @default(uuid())
  clinicId         String
  patientId        String?
  patientName      String?
  patientPhone     String?
  doctorId         String?
  doctorName       String?
  preferredDate    DateTime?
  preferredTime    String?
  preferredService String?
  notes            String?
  status           WaitingListStatus @default(waiting)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, status])
  @@map("waiting_list")
}

model Expense {
  id          String   @id @default(uuid())
  clinicId    String
  category    String?
  amount      Int
  description String?
  notes       String?
  date        DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, date])
  @@map("expenses")
}

model Promotion {
  id              String    @id @default(uuid())
  clinicId        String
  title           String
  description     String?
  discountPercent Int?      @default(0)
  serviceIds      Json?
  startDate       DateTime?
  endDate         DateTime?
  active          Boolean   @default(true)
  imageUrl        String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@map("promotions")
}

model PriceListItem {
  id          String  @id @default(uuid())
  clinicId    String
  serviceCode String
  name        String?
  price       Int
  matCost     Int     @default(0)
  active      Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([clinicId, serviceCode])
  @@index([clinicId])
  @@map("price_list")
}

model ReminderLog {
  id          String   @id @default(uuid())
  clinicId    String
  reminderKey String
  channel     String?
  sentAt      DateTime @default(now())
  meta        Json?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, reminderKey])
  @@map("reminder_logs")
}

model Chair {
  id        String  @id @default(uuid())
  clinicId  String
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, active])
  @@map("chairs")
}

// --- MEDICAL RECORDS ---

model Visit {
  id         String    @id @default(uuid())
  patientId  String
  doctorId   String
  date       DateTime  @default(now())
  diagnosis  String?
  complaints String?
  anamnesis  String?
  treatment  Json?
  notes      String?
  deletedAt  DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@map("visits")
}

model Tooth {
  id        String  @id @default(uuid())
  patientId String
  number    Int
  condition String?
  diagnosis String?
  notes     String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([patientId, number])
  @@map("teeth")
}

model TreatmentPlan {
  id        String     @id @default(uuid())
  patientId String
  title     String
  status    PlanStatus @default(draft)
  items     Json
  price     Int?
  notes     String?
  deletedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([patientId])
  @@map("treatment_plans")
}

model PatientImage {
  id        String    @id @default(uuid())
  patientId String
  type      ImageType
  url       String
  name      String?
  metadata  Json?
  deletedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([patientId])
  @@map("patient_images")
}

model Document {
  id        String    @id @default(uuid())
  patientId String?
  clinicId  String?
  type      String
  name      String?
  url       String
  signed    Boolean   @default(false)
  signedAt  DateTime?
  deletedAt DateTime?

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  clinic  Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([patientId])
  @@map("documents")
}

// --- LAB ORDERS ---

model LabOrder {
  id        String         @id @default(uuid())
  patientId String?
  clinicId  String
  labName   String?
  status    LabOrderStatus @default(pending)
  type      String?
  notes     String?
  files     Json?
  deadline  DateTime?
  price     Int?

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@map("lab_orders")
}

// --- BILLING ---

model Invoice {
  id        String        @id @default(uuid())
  clinicId  String
  patientId String?
  amount    Int
  status    InvoiceStatus @default(unpaid)
  items     Json
  notes     String?
  paidAt    DateTime?
  deletedAt DateTime?

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@map("invoices")
}

// --- INVENTORY ---

model InventoryItem {
  id       String  @id @default(uuid())
  clinicId String
  name     String
  category String?
  quantity Int     @default(0)
  minimum  Int     @default(0)
  price    Int?
  unit     String?
  supplier String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@map("inventory")
}

// --- AI CORE ---

model AISession {
  id       String @id @default(uuid())
  userId   String
  clinicId String
  messages Json
  context  Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  aiMessages AIMessage[]

  @@index([userId])
  @@map("ai_sessions")
}

model AIAction {
  id      String       @id @default(uuid())
  userId  String
  intent  String
  payload Json
  status  ActionStatus @default(pending)
  result  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId])
  @@map("ai_actions")
}

model AIAlert {
  id       String  @id @default(uuid())
  userId   String
  type     String
  priority String  @default("low")
  message  String
  resolved Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId, resolved])
  @@map("ai_alerts")
}

// --- MARKETPLACE ---

// --- ECOSYSTEM: SUPPLIERS ---

enum SupplierStatus {
  pending
  documents_review
  verified
  official_partner
  suspended
}

enum SupplierKind {
  MANUFACTURER
  DISTRIBUTOR
  SUPPLIER
  BRAND_REPRESENTATIVE
}

model Supplier {
  id            String         @id @default(uuid())
  name          String
  kind          SupplierKind   @default(SUPPLIER)
  bin           String?
  legalAddress  String?
  city          String?
  contactPerson String?
  phone         String?
  email         String?
  status        SupplierStatus @default(pending)

  logo           String?
  description    String?
  commissionRate Int     @default(500) // 5% in bps
  deliveryConfig Json? // delivery settings
  bankDetails    Json? // bank info for payouts
  returnPolicy   String?
  minOrderPrice  Int     @default(0)
  rating         Float?
  reviewCount    Int     @default(0)
  orderCount     Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  products      Product[]
  documents     SupplierDocument[]
  members       SupplierMember[]
  deliveryZones DeliveryZone[]
  orders        Order[]
  promotions    ShopPromotion[]

  @@index([city])
  @@index([status])
  @@index([isActive])
  @@map("suppliers")
}

model SupplierMember {
  id         String   @id @default(uuid())
  userId     String
  supplierId String
  role       String   @default("owner")
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([userId, supplierId])
  @@index([userId])
  @@map("supplier_members")
}

model SupplierDocument {
  id         String  @id @default(uuid())
  supplierId String
  type       String
  url        String
  verified   Boolean @default(false)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([supplierId])
  @@map("supplier_documents")
}

model Product {
  id          String  @id @default(uuid())
  name        String
  brand       String?
  category    String? // kept for backward compat
  categoryId  String? // FK to ShopCategory tree
  price       Int
  oldPrice    Int? // original price for discount display
  stock       Int     @default(0)
  minStock    Int     @default(0)
  description String?
  imageUrl    String? // main image
  images      Json? // additional images array
  rating      Float?
  reviewCount Int     @default(0)
  supplierId  String?
  sharedProductId String? @map("shared_product_id") // canonical product id grouping supplier offers
  ownBrand    Boolean @default(false)

  // Rich catalog fields
  sku            String? // Р°СЂС‚РёРєСѓР»
  unit           String? // С€С‚, РєРі, РЅР°Р±РѕСЂ...
  currency       String  @default("KZT")
  tags           Json? // array of tags
  specs          Json? // key-value characteristics
  seoTitle       String?
  seoDescription String?
  videoUrl       String?
  model3dUrl     String? // 3D model for equipment
  weight         Float? // kg for delivery calc

  manufacturer  String?
  country       String?
  expiryDate    DateTime?
  compatibility String? // kept for backward compat

  isActive Boolean @default(true)

  favorites    Favorite[]
  reviews      ShopReview[]
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  shopCategory ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([supplierId])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Order {
  id       String  @id @default(uuid())
  clinicId String? // optional for marketplace-only users
  userId   String
  items    Json // snapshot of order lines
  status   String  @default("pending")
  total    Int
  meta     Json?

  // Marketplace delivery & payment
  deliveryAddress       String?
  deliveryMethod        String? // self_pickup, courier, post
  deliveryCost          Int       @default(0)
  paymentMethod         String? // kaspi_qr, card, cash
  paymentStatus         String    @default("pending")
  recipientName         String?
  recipientPhone        String?
  notes                 String?
  estimatedDeliveryDate DateTime?
  deliveredAt           DateTime?
  supplierId            String?
  cancelledAt           DateTime?
  cancelReason          String?

  clinic   Clinic?      @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reviews  ShopReview[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId])
  @@index([clinicId])
  @@index([supplierId])
  @@index([status])
  @@map("orders")
}

model Favorite {
  id        String @id @default(uuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

// в”Ђв”Ђв”Ђ MARKETPLACE V2: CATEGORIES & SPECS в”Ђв”Ђв”Ђ

model ShopCategory {
  id          String  @id @default(uuid())
  parentId    String?
  name        String
  slug        String  @unique
  icon        String?
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  parent   ShopCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ShopCategory[] @relation("CategoryTree")

  products      Product[]
  specTemplates SpecTemplate[]
  presets       ProductPreset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([parentId])
  @@index([slug])
  @@index([isActive, sortOrder])
  @@map("shop_categories")
}

enum SpecFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model SpecTemplate {
  id         String        @id @default(uuid())
  categoryId String?
  name       String
  type       SpecFieldType @default(TEXT)
  unit       String? // РµРґ. РёР·РјРµСЂРµРЅРёСЏ
  options    Json? // for SELECT/MULTI_SELECT: [{ value, label }]
  required   Boolean       @default(false)
  sortOrder  Int           @default(0)

  category ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([categoryId])
  @@map("spec_templates")
}

// в”Ђв”Ђв”Ђ MARKETPLACE V2: REVIEWS в”Ђв”Ђв”Ђ

model ShopReview {
  id           String  @id @default(uuid())
  productId    String
  userId       String
  clinicId     String?
  orderId      String?
  rating       Int
  pros         String?
  cons         String?
  comment      String?
  images       Json? // array of image URLs
  isApproved   Boolean @default(true)
  helpfulCount Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clinic  Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([productId, userId, orderId])
  @@index([productId, rating])
  @@index([userId])
  @@index([isApproved])
  @@map("shop_reviews")
}

// в”Ђв”Ђв”Ђ MARKETPLACE V2: DELIVERY в”Ђв”Ђв”Ђ

model DeliveryZone {
  id            String  @id @default(uuid())
  supplierId    String
  name          String // e.g. "РђР»РјР°С‚С‹", "РЁС‹РјРєРµРЅС‚"
  cities        Json? // array of city/region names

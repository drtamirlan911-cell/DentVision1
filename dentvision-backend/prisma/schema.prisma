enum ReferralStatus {
  DRAFT
  SENT
  ACCEPTED
  SCHEDULED
  PATIENT_ARRIVED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  DELIVERED
  CLOSED
  CANCELLED
}

enum ReferralPriority {
  NORMAL
  URGENT
  EMERGENCY
}

model DiagnosticCenter {
  id         String   @id @default(uuid())
  name       String
  city       String?
  address    String?
  phone      String?
  email      String?
  rating     Float?   @default(0)
  logo       String?
  lat        Float?
  lng        Float?
  active     Boolean  @default(true)
  accredited Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members      DiagnosticCenterMember[]
  referrals    Referral[]               @relation("CenterReferral")
  studies      DiagnosticStudy[]
  operators    Operator[]
  radiologists Radiologist[]
  bookings     DiagnosticBooking[]
  schedules    Schedule[]

  @@map("diagnostic_centers")
}

model DiagnosticCenterMember {
  id        String   @id @default(uuid())
  centerId  String
  userId    String
  role      String // admin | radiologist | operator | manager
  createdAt DateTime @default(now())

  center DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([centerId, userId])
  @@index([userId])
  @@map("diagnostic_center_members")
}

model Laboratory {
  id         String   @id @default(uuid())
  name       String
  city       String?
  address    String?
  phone      String?
  email      String?
  rating     Float?   @default(0)
  accredited Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members   LaboratoryMember[]
  referrals Referral[]          @relation("LabReferral")
  tests     LaboratoryTest[]
  bookings  DiagnosticBooking[]

  @@map("laboratories")
}

model LaboratoryMember {
  id        String   @id @default(uuid())
  labId     String
  userId    String
  role      String
  createdAt DateTime @default(now())

  lab  Laboratory @relation(fields: [labId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([labId, userId])
  @@index([userId])
  @@map("laboratory_members")
}

model DiagnosticStudy {
  id          String             @id @default(uuid())
  centerId    String
  name        String // CBCT, OPG, TRG, etc.
  category    DiagnosticCategory
  description String?
  price       Decimal?           @default(0)
  durationMin Int?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())

  center   DiagnosticCenter    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  bookings DiagnosticBooking[]

  @@index([centerId])
  @@index([category])
  @@map("diagnostic_studies")
}

model LaboratoryTest {
  id           String             @id @default(uuid())
  labId        String
  name         String
  category     DiagnosticCategory
  description  String?
  price        Decimal?           @default(0)
  turnaroundHr Int?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())

  lab Laboratory @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([category])
  @@map("laboratory_tests")
}

model Operator {
  id        String   @id @default(uuid())
  centerId  String
  userId    String
  specialty String? // CBCT, OPG, etc.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  center    DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([centerId])
  @@map("operators")
}

model Radiologist {
  id        String   @id @default(uuid())
  centerId  String
  userId    String
  specialty String? // 3D, general
  license   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  center    DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([centerId])
  @@map("radiologists")
}

model Referral {
  id               String             @id @default(uuid())
  // Patient info (snapshot at time of referral)
  patientId        String?
  patientName      String
  patientIin       String?
  patientBirth     DateTime?
  patientAge       Int?
  patientGender    String?
  patientPhone     String?
  patientEmail     String?
  pregnancy        Boolean            @default(false)
  allergies        String?
  specialNotes     String?
  patientPhoto     String?
  // Doctor info
  clinicId         String
  doctorId         String
  doctorName       String?
  doctorPhone      String?
  doctorEmail      String?
  // Diagnostic type
  category         DiagnosticCategory
  studyType        String // specific: CBCT, OPG, Histology, Allergy, etc.
  anatomicalSites  Json? // selected teeth/regions [{region, teeth[]}]
  // Clinical
  complaints       String?
  preliminaryDx    String?
  studyGoal        String?
  commentForDoctor String?
  commentForLab    String?
  priority         ReferralPriority   @default(NORMAL)
  status           ReferralStatus     @default(DRAFT)
  // Assignment
  centerId         String?
  labId            String?
  operatorId       String?
  radiologistId    String?
  // Schedule
  scheduledDate    DateTime?
  scheduledTime    String?
  // Finance
  cost             Decimal?           @default(0)
  platformFee      Decimal?           @default(0)
  paid             Boolean            @default(false)
  paidAt           DateTime?
  // Audit
  reviewerId       String?
  reviewedAt       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  clinic      Clinic            @relation(fields: [clinicId], references: [id])
  doctor      User              @relation(fields: [doctorId], references: [id])
  patient     Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  center      DiagnosticCenter? @relation("CenterReferral", fields: [centerId], references: [id])
  lab         Laboratory?       @relation("LabReferral", fields: [labId], references: [id])
  operator    Operator?         @relation(fields: [operatorId], references: [id])
  radiologist Radiologist?      @relation(fields: [radiologistId], references: [id])
  reviewer    User?             @relation("ReferralReviewer", fields: [reviewerId], references: [id])
  files       ReferralFile[]
  comments    ReferralComment[]
  result      DiagnosticResult?

  @@index([clinicId])
  @@index([centerId])
  @@index([labId])
  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("referrals")
}

model ReferralFile {
  id         String   @id @default(uuid())
  referralId String
  fileName   String
  fileType   String // image|pdf|dicom|stl|zip
  fileUrl    String
  fileSize   Int?
  uploadedBy String
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id])

  @@index([referralId])
  @@map("referral_files")
}

model ReferralComment {
  id         String   @id @default(uuid())
  referralId String
  authorId   String
  text       String
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([referralId])
  @@map("referral_comments")
}

model DiagnosticResult {
  id          String    @id @default(uuid())
  referralId  String    @unique
  reportText  String? // Rich text / HTML
  conclusion  String?
  pdfUrl      String?
  signedBy    String?
  signedAt    DateTime?
  aiSummary   String?
  aiGenerated Boolean   @default(false)
  templateId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  signer   User?    @relation(fields: [signedBy], references: [id])

  @@map("diagnostic_results")
}

model DiagnosticBooking {
  id           String   @id @default(uuid())
  referralId   String?
  centerId     String?
  labId        String?
  studyId      String?
  patientName  String
  patientPhone String?
  date         DateTime
  time         String
  durationMin  Int?
  notes        String?
  status       String   @default("pending") // pending|confirmed|completed|cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  center DiagnosticCenter? @relation(fields: [centerId], references: [id])
  lab    Laboratory?       @relation(fields: [labId], references: [id])
  study  DiagnosticStudy?  @relation(fields: [studyId], references: [id])

  @@index([centerId])
  @@index([date])
  @@map("diagnostic_bookings")
}

model Schedule {
  id        String   @id @default(uuid())
  centerId  String
  date      DateTime
  startTime String
  endTime   String
  slots     Int      @default(1)
  available Boolean  @default(true)
  createdAt DateTime @default(now())

  center DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, date])
  @@map("diagnostic_schedules")
}

model RegistrationRequest {
  id         String   @id @default(uuid())
  type       String // "center" | "laboratory"
  name       String
  city       String?
  address    String?
  phone      String?
  email      String?
  comment    String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewerId String?
  reviewNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("registration_requests")
}

// в”Ђв”Ђв”Ђ LEGAL ENGINE в”Ђв”Ђв”Ђ

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  EXPIRED
  CANCELLED
}

enum TemplateType {
  CLINIC_AGREEMENT
  DIAGNOSTICS_AGREEMENT
  LABORATORY_AGREEMENT
  MARKETPLACE_AGREEMENT
  SUPPLIER_AGREEMENT
  LECTURER_AGREEMENT
  ACADEMY_AGREEMENT
  NDA
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  AI_POLICY
  COOKIE_POLICY
  DPA
  SLA
  API_AGREEMENT
  REFERRAL_AGREEMENT
}

model LegalTemplate {
  id             String       @id @default(uuid())
  type           TemplateType
  name           String
  description    String?
  blocks         String[] // РјР°СЃСЃРёРІ LegalBlock.id
  variables      Json // { "CompanyName": "string", "BIN": "string" }
  currentVersion Int          @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  creator   User     @relation("TemplateCreator", fields: [createdBy], references: [id])

  versions  LegalTemplateVersion[]
  documents LegalDocument[]

  @@map("legal_templates")
}

model LegalTemplateVersion {
  id          String         @id @default(uuid())
  templateId  String
  template    LegalTemplate  @relation(fields: [templateId], references: [id])
  version     Int
  content     String // HTML СЃ {{РїРµСЂРµРјРµРЅРЅС‹РјРё}}
  changelog   String?
  status      DocumentStatus @default(DRAFT)
  publishedAt DateTime?
  approvedBy  String?
  approver    User?          @relation("VersionApprover", fields: [approvedBy], references: [id])

  createdAt DateTime @default(now())
  createdBy String
  creator   User     @relation("VersionCreator", fields: [createdBy], references: [id])

  @@map("legal_template_versions")
}

model LegalBlock {
  id        String   @id @default(uuid())
  name      String
  category  String // "core", "financial", "data", "dispute"
  content   String // HTML/Markdown СЃ {{РїРµСЂРµРјРµРЅРЅС‹РјРё}}
  variables String[] // СЃРїРёСЃРѕРє РїРµСЂРµРјРµРЅРЅС‹С… РІРЅСѓС‚СЂРё Р±Р»РѕРєР°
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  creator   User     @relation("BlockCreator", fields: [createdBy], references: [id])

  @@map("legal_blocks")
}

model LegalPartner {
  id             String      @id @default(uuid())
  userId         String?     @unique
  user           User?       @relation(fields: [userId], references: [id])
  type           PartnerType
  legalName      String
  bin            String?
  director       String?
  address        String?
  iban           String?
  phone          String?
  email          String?
  commission     Decimal?    @db.Decimal(5, 2)
  plan           String?
  subscriptionId String?

  documents LegalDocument[]
  invoices  LegalInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  creator   User     @relation("PartnerCreator", fields: [createdBy], references: [id])

  @@map("legal_partners")
}

model LegalDocument {
  id             String         @id @default(uuid())
  documentNumber String         @unique
  templateId     String
  template       LegalTemplate  @relation(fields: [templateId], references: [id])
  partnerId      String
  partner        LegalPartner   @relation(fields: [partnerId], references: [id])
  version        Int            @default(1)
  status         DocumentStatus @default(DRAFT)
  content        String // С„РёРЅР°Р»СЊРЅС‹Р№ HTML
  variables      Json // { "CompanyName": "РћРћРћ Р”РµРЅС‚", ... }
  effectiveDate  DateTime?
  expirationDate DateTime?
  approvedBy     String?
  approver       User?          @relation("DocApprover", fields: [approvedBy], references: [id])
  linkedDocs     String[]

  ecpStatus     String? // "pending" | "signed" | "rejected"
  ecpSignedAt   DateTime?
  ecpCertSerial String?
  ecpProvider   String? // "NCALayer" | "EGov" | "Signature Gateway"
  ecpSignature  String? // base64

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  creator   User     @relation("DocCreator", fields: [createdBy], references: [id])

  versions  LegalDocumentVersion[]
  auditLogs LegalAuditLog[]
  invoices  LegalInvoice[]

  @@index([partnerId])
  @@index([templateId])
  @@map("legal_documents")
}

model LegalDocumentVersion {
  id         String         @id @default(uuid())
  documentId String
  document   LegalDocument  @relation(fields: [documentId], references: [id])
  version    Int
  content    String
  status     DocumentStatus
  changelog  String?
  createdAt  DateTime       @default(now())
  createdBy  String
  creator    User           @relation("DocVersionCreator", fields: [createdBy], references: [id])

  @@map("legal_document_versions")
}

model LegalAuditLog {
  id          String          @id @default(uuid())
  documentId  String
  document    LegalDocument   @relation(fields: [documentId], references: [id])
  action      String // CREATED, STATUS_CHANGED, VERSION_ADDED, EXPORTED, VIEWED
  fromStatus  DocumentStatus?
  toStatus    DocumentStatus?
  fromVersion Int?
  toVersion   Int?
  diff        Json?
  performedBy String
  performer   User            @relation(fields: [performedBy], references: [id])
  createdAt   DateTime        @default(now())

  @@index([documentId])
  @@index([performedBy])
  @@map("legal_audit_logs")
}

model LegalInvoice {
  id            String         @id @default(uuid())
  invoiceNumber String         @unique
  partnerId     String
  partner       LegalPartner   @relation(fields: [partnerId], references: [id])
  documentId    String?
  document      LegalDocument? @relation(fields: [documentId], references: [id])
  amountKzt     BigInt
  status        InvoiceStatus  @default(unpaid)
  issuedAt      DateTime       @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  description   String?
  createdBy     String
  creator       User           @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_invoices")
}

// в”Ђв”Ђв”Ђ AI ADMIN вЂ” WhatsApp / Instagram webhook gateway в”Ђв”Ђв”Ђ

enum AiAdminChannel {
  WHATSAPP
  INSTAGRAM
}

enum AiAdminMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum AiAdminSessionStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

model ClinicMessengerConfig {
  id                 String         @id @default(cuid())
  clinicId           String
  channel            AiAdminChannel
  channelAccountId   String
  verifyToken        String         @default("")
  accessToken        String         @default("")
  refreshToken       String?
  businessId         String?
  wabaId             String?
  pageId             String?
  instagramAccountId String?
  phoneNumberId      String?
  phoneNumber        String?
  permissions        Json?
  expiresAt          DateTime?
  webhookSubscribed  Boolean        @default(false)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sessions AiAdminSession[]

  @@unique([channel, channelAccountId])
  @@index([clinicId])
  @@map("clinic_messenger_configs")
}

model AiAdminSession {
  id             String                @id @default(cuid())
  clinicId       String
  configId       String
  config         ClinicMessengerConfig @relation(fields: [configId], references: [id])
  channel        AiAdminChannel
  externalUserId String
  patientName    String?
  patientPhone   String?
  status         AiAdminSessionStatus  @default(ACTIVE)
  lastMessageAt  DateTime              @default(now())
  createdAt      DateTime              @default(now())

  messages AiAdminMessage[]

  @@unique([channel, externalUserId, clinicId])
  @@index([clinicId, status])
  @@index([lastMessageAt])
  @@map("ai_admin_sessions")
}

model AiAdminMessage {
  id         String             @id @default(cuid())
  sessionId  String
  session    AiAdminSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       AiAdminMessageRole
  content    String
  toolName   String?
  toolResult Json?
  tokensUsed Int?
  latencyMs  Int?
  createdAt  DateTime           @default(now())

  @@index([sessionId])
  @@map("ai_admin_messages")
}

model AiAdminEscalation {
  id              String    @id @default(cuid())
  sessionId       String
  clinicId        String
  reason          String
  lastUserMessage String
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime  @default(now())

  @@index([clinicId, resolvedAt])
  @@map("ai_admin_escalations")
}

// ─── UNIVERSAL ORGANIZATION / PERSON / IAM v2 ───

model Organization {
  id       String  @id @default(uuid())
  name     String
  type     String // CLINIC | ACADEMY | LABORATORY | DIAGNOSTIC_CENTER | SUPPLIER_COMPANY | PARTNER
  taxId    String?
  address  String?
  phone    String?
  email    String?
  logo     String?
  contacts Json?
  settings Json? // type-specific settings (plan, courses config, delivery config, etc.)

  // Link back to original table for backward compatibility during migration
  originalType String? // 'Clinic' | 'Supplier' | 'Academy' | 'DiagnosticCenter' | 'Laboratory' | 'Partner'
  originalId   String? // ID in the original table

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  persons Person[]

  @@unique([originalType, originalId])
  @@index([type])
  @@index([name])
  @@map("organizations")
}

model Person {
  id             String  @id @default(uuid())
  fullName       String
  personType     String // DOCTOR | LECTURER | SELLER | SUPPLIER_REP | STAFF | OPERATOR | RADIOLOGIST
  organizationId String? @map("organization_id")
  userId         String? @unique // optional link to platform User account
  phone          String?
  email          String?
  specialization String?
  bio            String?
  avatar         String?
  contacts       Json?

  // Link back to original table for backward compatibility
  originalType String? // 'User' | 'Lecturer' | 'SupplierMember' | 'DiagnosticCenterMember' | etc.
  originalId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  personRoles  PersonRole[]

  @@unique([originalType, originalId])
  @@index([personType])
  @@index([organizationId])
  @@map("persons")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. 'patients:read', 'appointments:write'
  name        String
  description String?
  domain      String // 'crm' | 'finance' | 'settings' | 'admin' | 'ai' | etc.

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@map("permissions")
}

model Role {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. 'org_admin', 'doctor', 'lecturer', 'seller'
  name        String
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted

  permissions RolePermission[]

  createdAt   DateTime     @default(now())
  personRoles PersonRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PersonRole {
  id        String  @id @default(uuid())
  personId  String
  roleId    String
  scopeType String? // 'organization' | 'platform' | null
  scopeId   String? // organization ID if scoped

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([personId, roleId])
  @@index([personId])
  @@index([roleId])
  @@map("person_roles")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

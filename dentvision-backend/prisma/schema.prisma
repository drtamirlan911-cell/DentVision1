generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserRole {
  OWNER
  DOCTOR
  ASSISTANT
  ADMIN
  CASHIER
  LAB
  MANAGER
  STUDENT
  SUPERADMIN
  SUPPORT
}

enum ClinicPlan {
  DEMO
  STANDARD
  PRO
  ENTERPRISE
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum InvoiceStatus {
  paid
  unpaid
  partial
  refund
  pending
  overdue
}

enum ImageType {
  PHOTO
  X_RAY
  CBCT
  DICOM
  SCAN
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum WaitingListStatus {
  waiting
  called
  cancelled
}

enum PlanStatus {
  draft
  active
  completed
  cancelled
  proposed
  accepted
  in_progress
}

enum LabOrderStatus {
  pending
  in_progress
  completed
  cancelled
  delivered
  // Added so the enum matches VALID_STATUSES in lab.routes.ts, which had
  // accepted these as valid input since the dental-lab workflow (sent to lab,
  // fabrication, try-in with the patient, adjustment, ready for pickup,
  // remake, delayed) was written — the DB enum was just never updated to
  // match, so PATCH /:id/status 500'd on every one of them.
  sent
  try_in
  adjustment
  ready
  remake
  delayed
}

enum NotificationType {
  info
  warning
  error
  appointment
  promotion
  system
  subscription
  workflow
}

enum PaymentProvider {
  kaspi
  card
  cash
  other
  kaspi_qr
  clinic_kaspi
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  created
  expired
}

// --- USER SYSTEM ---

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  /// Absent for accounts that only ever signed in with Google. `comparePassword`
  /// has exactly one caller, which refuses a password login when this is null —
  /// the account is not passwordless by accident, it simply has no password yet.
  /// Password reset is the supported way to add one.
  password    String?
  /// Google's stable subject id. The link is recorded as a fact rather than
  /// inferred from "has no password", so an account cannot be quietly
  /// re-pointed at a different Google identity.
  googleId    String?  @unique
  firstName   String
  lastName    String
  avatar      String?
  phone       String?
  spec        String?
  profileMeta Json?
  role        UserRole @default(DOCTOR)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  memberships                   ClinicMember[]
  aiSessions                    AISession[]
  notifications                 Notification[]
  orders                        Order[]
  enrollments                   SchoolEnrollment[]
  appointments                  Appointment[]
  labOrdersOrdered              LabOrder[]                   @relation("LabOrderDoctor")
  academies                     Academy[]
  lecturerProfile               Lecturer?
  aiMessages                    AIMessage[]
  communityPosts                CommunityPost[]
  communityLikes                CommunityLike[]
  communityComments             CommunityComment[]
  communitySaves                CommunitySave[]
  dmParticipants                DmParticipant[]
  dmMessages                    DmMessage[]
  favorites                     Favorite[]
  reviews                       ShopReview[]
  dentCashLedgers               DentCashLedger[]
  developerApps                 DeveloperApp[]
  userSessions                  UserSession[]
  consents                      Consent[]
  uploadedMedicalFiles          MedicalFileAccess[]          @relation("UploadedFiles")
  viewedMedicalFiles            MedicalFileAccess[]          @relation("ViewedFiles")
  downloadedMedicalFiles        MedicalFileAccess[]          @relation("DownloadedFiles")
  passwordResets                PasswordReset[]
  patients                      Patient[]
  aiActionLogs                  AIActionLog[]                @relation("UserActions")
  confirmedAiActions            AIActionLog[]                @relation("ConfirmedActions")
  jobVacancies                  JobVacancy[]
  jobApplications               JobApplication[]
  diagnosticReferrals           Referral[]
  reviewedReferrals             Referral[]                   @relation("ReferralReviewer")
  uploadedReferralFiles         ReferralFile[]
  referralComments              ReferralComment[]
  signedResults                 DiagnosticResult[]
  diagnosticCenterMembers       DiagnosticCenterMember[]
  laboratoryMembers             LaboratoryMember[]
  operators                     Operator[]
  radiologists                  Radiologist[]
  legalTemplatesCreated         LegalTemplate[]              @relation("TemplateCreator")
  legalTemplateVersionsCreated  LegalTemplateVersion[]       @relation("VersionCreator")
  legalTemplateVersionsApproved LegalTemplateVersion[]       @relation("VersionApprover")
  legalBlocksCreated            LegalBlock[]                 @relation("BlockCreator")
  legalPartnersCreated          LegalPartner[]               @relation("PartnerCreator")
  legalPartnerUser              LegalPartner?                @relation
  legalDocumentsCreated         LegalDocument[]              @relation("DocCreator")
  legalDocumentsApproved        LegalDocument[]              @relation("DocApprover")
  legalDocumentVersionsCreated  LegalDocumentVersion[]       @relation("DocVersionCreator")
  legalAuditLogs                LegalAuditLog[]
  legalInvoicesCreated          LegalInvoice[]
  notificationPreferences       NotificationPreference[]
  auditLogs                     AuditLog[]
  aiEvents                      AIEvent[]
  crossClinicGrantsAsPatient    CrossClinicAccessGrant[]     @relation("CrossClinicGrantAsPatient")
  crossClinicGrantsRequested    CrossClinicAccessGrant[]     @relation("CrossClinicGrantRequestedBy")
  crossClinicAccessLogs         CrossClinicAccessLog[]
  planReleasesApproved          TreatmentPlanRelease[]       @relation("PlanReleaseApprover")
  patientConversationsAsPatient PatientConversation[]        @relation("PatientConversationAsPatient")
  patientConversationsAssigned  PatientConversation[]        @relation("PatientConversationAssignee")
  patientConversationMessages   PatientConversationMessage[]

  @@map("users")
}

model Clinic {
  id       String     @id @default(uuid())
  name     String
  city     String?
  address  String?
  phone    String?
  logo     String?
  plan     ClinicPlan @default(DEMO)
  active   Boolean    @default(true)
  settings Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  members             ClinicMember[]
  invitations         ClinicInvitation[]
  patients            Patient[]
  appointments        Appointment[]
  labOrders           LabOrder[]
  treatmentPlans      TreatmentPlan[]
  invoices            Invoice[]
  inventory           InventoryItem[]
  inventoryMovements  InventoryMovement[]
  stockDeductionRules StockDeductionRule[]
  orders              Order[]
  waitingList         WaitingList[]
  expenses            Expense[]
  promotions          Promotion[]
  priceList           PriceListItem[]
  reminderLogs        ReminderLog[]
  chairs              Chair[]
  bookings            Booking[]
  documents           Document[]
  aiMessages          AIMessage[]
  jobVacancies        JobVacancy[]
  customerMetrics     CustomerMetrics[]
  serviceAccesses     ServiceAccess[]
  diagnosticReferrals Referral[]

  reviews                      ShopReview[]
  auditLogs                    AuditLog[]
  aiEvents                     AIEvent[]
  crossClinicGrantsAsSource    CrossClinicAccessGrant[] @relation("CrossClinicGrantAsSource")
  crossClinicGrantsAsReceiving CrossClinicAccessGrant[] @relation("CrossClinicGrantAsReceiving")
  patientConversations         PatientConversation[]
  treatmentPlanReleases        TreatmentPlanRelease[]
  patientPresentations         PatientPresentation[]

  @@map("clinics")
}

model Booking {
  id          String        @id @default(uuid())
  clinicId    String
  patientName String
  phone       String
  email       String?
  doctorId    String?
  doctorName  String?
  serviceName String?
  date        DateTime      @db.Date
  time        String
  notes       String?
  status      BookingStatus @default(pending)
  source      String        @default("online")

  /// Set when this request was filed from a patient's presentation screen —
  /// the concierge funnel's last, and so far only, tracked conversion.
  /// Optional: the public widget and every other booking path leave it null.
  releaseId String?

  clinic  Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  release TreatmentPlanRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, status, date])
  @@index([releaseId])
  @@map("bookings")
}

model ClinicMember {
  id                String   @id @default(uuid())
  userId            String
  clinicId          String
  role              UserRole @default(DOCTOR)
  commissionPercent Int      @default(30)
  baseSalary        Int      @default(0)
  payType           String   @default("commission")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  joinedAt  DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("clinic_members")
}

model ClinicInvitation {
  id        String    @id @default(uuid())
  clinicId  String
  email     String?
  role      UserRole  @default(DOCTOR)
  code      String    @unique
  expiresAt DateTime?
  usedAt    DateTime?
  usedBy    String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@map("clinic_invitations")
}

// --- PATIENT CRM ---

model Patient {
  id             String    @id @default(uuid())
  clinicId       String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  birthDate      DateTime?
  gender         String?
  address        String?
  notes          String?
  iin            String?
  /// HMAC-SHA256 of the normalized plaintext IIN (deterministic blind index).
  /// `iin` itself is encrypted with a random IV (fieldEncryption.ts) so two
  /// encryptions of the same IIN never match — this is what makes "does this
  /// person have records at another clinic" a queryable equality lookup at
  /// all. Written alongside every `iin` write via `hmacIin()` (lib/phi.ts).
  iinHash        String?   @db.VarChar(64)
  medicalHistory Json?
  prepaidBalance Int       @default(0)
  deletedAt      DateTime?
  userId         String?

  clinic                       Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user                         User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits                       Visit[]
  appointments                 Appointment[]
  teeth                        Tooth[]
  treatmentPlans               TreatmentPlan[]
  images                       PatientImage[]
  documents                    Document[]
  labOrders                    LabOrder[]
  invoices                     Invoice[]
  aiActionLogs                 AIActionLog[]
  medicalFileAccesses          MedicalFileAccess[]
  diagnosticReferrals          Referral[]
  crossClinicGrantsAsSource    CrossClinicAccessGrant[] @relation("CrossClinicGrantSourcePatient")
  crossClinicGrantsAsReceiving CrossClinicAccessGrant[] @relation("CrossClinicGrantReceivingPatient")
  treatmentPlanReleases        TreatmentPlanRelease[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@index([iinHash])
  @@map("patients")
}

// --- APPOINTMENTS ---

model Appointment {
  id              String            @id @default(uuid())
  clinicId        String
  patientId       String
  doctorId        String
  date            DateTime
  time            String?
  duration        Int?              @default(30)
  status          AppointmentStatus @default(pending)
  type            String?
  notes           String?
  meta            Json?
  /// The plan this visit was booked to carry out, if any.
  ///
  /// Stage-level linkage already existed, but only inside
  /// `TreatmentPlan.items.stages[].appointmentId` — a JSON field a `WHERE`
  /// clause cannot reach. This is the plan-level anchor: not a replacement for
  /// the per-stage JSON link, but the one a funnel or reporting query can
  /// actually join on. Nullable and backfilled from that same JSON where it
  /// was already recorded; not every appointment serves a plan.
  treatmentPlanId String?

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  treatmentPlan TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, date])
  @@index([doctorId, date])
  @@index([treatmentPlanId])
  @@map("appointments")
}

// --- CRM OPS ---

model WaitingList {
  id               String            @id @default(uuid())
  clinicId         String
  patientId        String?
  patientName      String?
  patientPhone     String?
  doctorId         String?
  doctorName       String?
  preferredDate    DateTime?
  preferredTime    String?
  preferredService String?
  notes            String?
  status           WaitingListStatus @default(waiting)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, status])
  @@map("waiting_list")
}

model Expense {
  id          String   @id @default(uuid())
  clinicId    String
  category    String?
  amount      Int
  description String?
  notes       String?
  date        DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, date])
  @@map("expenses")
}

model Promotion {
  id              String    @id @default(uuid())
  clinicId        String
  title           String
  description     String?
  discountPercent Int?      @default(0)
  serviceIds      Json?
  startDate       DateTime?
  endDate         DateTime?
  active          Boolean   @default(true)
  imageUrl        String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@map("promotions")
}

model PriceListItem {
  id          String  @id @default(uuid())
  clinicId    String
  serviceCode String
  name        String?
  price       Int
  matCost     Int     @default(0)
  active      Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([clinicId, serviceCode])
  @@index([clinicId])
  @@map("price_list")
}

model ReminderLog {
  id          String   @id @default(uuid())
  clinicId    String
  reminderKey String
  channel     String?
  sentAt      DateTime @default(now())
  meta        Json?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, reminderKey])
  @@map("reminder_logs")
}

model Chair {
  id        String  @id @default(uuid())
  clinicId  String
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId, active])
  @@map("chairs")
}

// --- MEDICAL RECORDS ---

model Visit {
  id         String    @id @default(uuid())
  patientId  String
  doctorId   String
  date       DateTime  @default(now())
  diagnosis  String?
  complaints String?
  anamnesis  String?
  treatment  Json?
  notes      String?
  deletedAt  DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@map("visits")
}

model Tooth {
  id        String  @id @default(uuid())
  patientId String
  number    Int
  condition String?
  diagnosis String?
  notes     String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([patientId, number])
  @@map("teeth")
}

model TreatmentPlan {
  id        String     @id @default(uuid())
  patientId String
  /// The owning clinic, denormalised from `patient.clinicId`.
  ///
  /// Without it a plan is reachable only *through* its patient, so every funnel
  /// query, report and clinic-scoped guard had to join through `patients` — and
  /// `TreatmentPlanRelease` had to carry its own copy for exactly that reason.
  ///
  /// Nullable because plans already existed when it was added; the migration
  /// backfills every one of them from the patient. New writers set it.
  clinicId  String?
  title     String
  status    PlanStatus @default(draft)
  items     Json
  price     Int?
  notes     String?
  deletedAt DateTime?

  patient      Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic       Clinic?                @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  releases     TreatmentPlanRelease[]
  appointments Appointment[]
  invoices     Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([patientId])
  @@index([clinicId])
  @@map("treatment_plans")
}

/// Content-addressed cache of synthesised narration.
///
/// Keyed on the *text*, not on a beat or a plan or a patient: the same opening
/// sentence is spoken to every patient of every clinic, so it is synthesised
/// once for the whole platform and re-watching costs nothing. `clinicId` is
/// deliberately absent — it would fragment the cache and buy nothing.
///
/// Not a patient document: this never appears in the Documents tab and is not
/// reachable through the files routes.
model VoiceAsset {
  id         String @id @default(uuid())
  /// sha256(provider|model|voice|locale|normalised text)
  cacheKey   String @unique
  locale     String
  voice      String
  model      String
  /// `s3://<key>` — see lib/storage.ts::toStorageUrl.
  storageUrl String
  durationMs Int?
  bytes      Int

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([lastUsedAt])
  @@map("voice_assets")
}

enum PlanReleaseStatus {
  approved
  superseded
  withdrawn
}

/// A treatment plan as a named doctor signed it off: frozen, versioned, quotable.
///
/// `TreatmentPlan.items` is a mutable JSON blob with several writers, so it
/// cannot answer "what was this patient told, and by whom, on what date". A
/// release can: it holds a snapshot taken at approval time and never changes
/// afterwards. Nothing the patient sees is read from `TreatmentPlan` — only
/// from a release that is `approved` and has a `publishedAt`.
///
/// `clinicId` is denormalised because `TreatmentPlan` carries no clinic at all
/// (it is reachable only through `patient`), and every clinic-scoped read here
/// would otherwise have to join through the patient.
model TreatmentPlanRelease {
  id        String            @id @default(uuid())
  planId    String
  clinicId  String
  patientId String
  version   Int
  status    PlanReleaseStatus @default(approved)

  /// The canonical `items` shape, post-`enrichStages`, frozen at approval.
  snapshot     Json
  /// sha256 of the snapshot — the integrity anchor for "this is what was signed".
  snapshotHash String
  /// Recomputed from the snapshot's stages at approval. Never read from
  /// `TreatmentPlan.price`, which several writers leave stale.
  totalAmount  Int

  approvedByUserId String
  approvedAt       DateTime  @default(now())
  approvalNote     String?
  /// Patient-visible only once this is set. Separate from `approvedAt` on
  /// purpose: approving the medicine and publishing the words are two decisions.
  publishedAt      DateTime?
  /// A price shown to a patient is an offer, so it has to expire.
  expiresAt        DateTime?

  withdrawnAt       DateTime?
  withdrawnByUserId String?
  withdrawReason    String?

  /// The concierge funnel, Phase 6: first-touch timestamps for whether the
  /// patient actually opened and finished their presentation. Kept here,
  /// not on `PatientPresentation`, because a patient may watch the plain
  /// deterministic script with no `PatientPresentation` row ever existing —
  /// the release is the one anchor that is always there to record against.
  firstViewedAt DateTime?
  finishedAt    DateTime?

  plan       TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  clinic     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  approvedBy User          @relation("PlanReleaseApprover", fields: [approvedByUserId], references: [id])

  presentations PatientPresentation[]
  bookings      Booking[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([planId, version])
  @@index([clinicId, status, approvedAt])
  @@index([patientId, status])
  @@map("treatment_plan_releases")
}

enum PatientPresentationStatus {
  draft
  published
}

/// The LLM-rewritten wording for a release, reviewed by a doctor before a
/// patient can see it — Phase 5 of the concierge presentation.
///
/// `buildScriptSkeleton` never invents a fact; this table is what a model is
/// allowed to touch, and only after `scriptValidator.ts` accepts each line.
/// `script` carries the full `PresentationScript`, already merged with
/// whatever the model's rewrites survived review. `generatorByBeat` records,
/// per beat id, whether that line is `'template'`, `'llm'`, or `'doctor'` —
/// kept alongside the script rather than inside each beat, so the shared
/// `Beat` contract the frontend renders never has to carry a field it has no
/// use for. `validationReport` is the last `ScriptReview` from
/// `applyRewrite`, shown to the doctor in the preview screen; null until the
/// first generation.
///
/// Publishing this is a second, separate act from publishing the release: a
/// clinic that never generates a presentation still shows patients the plain
/// deterministic wording, unaffected by any of this.
model PatientPresentation {
  id        String                    @id @default(uuid())
  releaseId String
  clinicId  String
  locale    String                    @default("ru")
  status    PatientPresentationStatus @default(draft)

  script           Json
  generatorByBeat  Json
  validationReport Json?

  generatedByUserId String?
  generatedAt       DateTime?
  publishedByUserId String?
  publishedAt       DateTime?

  release TreatmentPlanRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  clinic  Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([releaseId, locale])
  @@index([clinicId, status])
  @@map("patient_presentations")
}

model PatientImage {
  id        String    @id @default(uuid())
  patientId String
  type      ImageType
  url       String
  name      String?
  metadata  Json?
  deletedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([patientId])
  @@map("patient_images")
}

model Document {
  id            String    @id @default(uuid())
  patientId     String?
  clinicId      String?
  type          String
  name          String?
  url           String
  signed        Boolean   @default(false)
  signedAt      DateTime?
  deletedAt     DateTime?
  /// One-time public link token for remote patient signing (send-signature).
  signToken     String?   @unique
  /// Signature image payload (base64 PNG from SignaturePad) — durable proof of consent.
  signatureData String?
  signedByName  String?

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  clinic  Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([patientId])
  @@map("documents")
}

// --- LAB ORDERS ---

model LabOrder {
  id        String         @id @default(uuid())
  patientId String?
  clinicId  String
  labName   String?
  status    LabOrderStatus @default(pending)
  type      String?
  notes     String?
  files     Json?
  deadline  DateTime?
  price     Int?

  /// Who ordered the work.
  ///
  /// The dental-lab workflow is doctor → patient → tooth → order, and the first
  /// step was not recorded anywhere: "whose case is this" could not be answered
  /// without guessing. Nullable, and deliberately **not** backfilled — the
  /// information does not exist for orders already placed, and inventing an
  /// attribution for clinical work would be worse than leaving it blank.
  doctorId String?

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctor  User?    @relation("LabOrderDoctor", fields: [doctorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@map("lab_orders")
}

// --- BILLING ---

model Invoice {
  id              String        @id @default(uuid())
  clinicId        String
  patientId       String?
  amount          Int
  status          InvoiceStatus @default(unpaid)
  items           Json
  notes           String?
  paidAt          DateTime?
  deletedAt       DateTime?
  /// The plan this invoice bills, if any. Same rationale as
  /// `Appointment.treatmentPlanId` — the per-stage JSON link
  /// (`items.stages[].invoiceId`) already existed but isn't queryable.
  treatmentPlanId String?

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  treatmentPlan TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([treatmentPlanId])
  @@map("invoices")
}

// --- INVENTORY ---

model InventoryItem {
  id       String  @id @default(uuid())
  clinicId String
  name     String
  category String?
  quantity Int     @default(0)
  minimum  Int     @default(0)
  price    Int?
  unit     String?
  supplier String?

  /// Артикул поставщика. Единственный надёжный ключ сопоставления с
  /// маркетплейсом: названия у одного и того же товара расходятся от
  /// поставщика к поставщику.
  sku String?

  /// Товар маркетплейса, который отражает эта позиция склада.
  ///
  /// Заполняется, когда позицию создал приход заказа или когда её выбрали
  /// из каталога при добавлении вручную. Специально без внешнего ключа:
  /// товар могут снять с продажи, а склад клиники от этого не должен
  /// потерять свою позицию.
  productId String?

  /// Срок годности партии.
  ///
  /// Форма склада собирала эту дату с самого начала, а колонки под неё не
  /// было — значение молча терялось, и фильтр «истекает срок» на странице
  /// не мог сработать ни разу.
  expiryDate DateTime?

  /// Принимать ли автоприход из доставленных заказов маркета.
  ///
  /// Клиника может вести часть позиций строго вручную (например, товар,
  /// который приходуется по факту вскрытия коробки), и автоматический
  /// плюс к остатку такую позицию ломает.
  autoRestock Boolean @default(true)

  clinic         Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]
  deductionLines StockDeductionRuleItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([clinicId])
  @@index([clinicId, productId])
  @@map("inventory")
}

/// Каждое изменение остатка — приход, списание, ручная правка.
///
/// Две задачи сразу. Во-первых, ответ на вопрос «куда делись перчатки»:
/// раньше остаток менялся молча и восстановить историю было нечем.
/// Во-вторых, идемпотентность: уникальный ключ (refType, refId, itemId) не даёт
/// одному и тому же заказу или приёму списать/оприходовать позицию дважды,
/// сколько бы раз ни повторился вызов.
model InventoryMovement {
  id       String @id @default(uuid())
  clinicId String
  itemId   String

  /// Изменение остатка со знаком: плюс — приход, минус — списание.
  delta Int

  /// Причина: order_delivery | appointment_close | manual | correction.
  reason String

  /// На что ссылается движение: order | appointment | null для ручных.
  refType String?
  refId   String?

  note   String?
  userId String?

  clinic Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// NULL-ы в Postgres не равны друг другу, поэтому ручные движения
  /// (refType/refId = NULL) под это ограничение не попадают и могут
  /// повторяться сколько угодно — ровно то, что нужно.
  @@unique([refType, refId, itemId])
  @@index([clinicId, createdAt])
  @@index([itemId, createdAt])
  @@map("inventory_movements")
}

/// Правило: что списать со склада после приёма.
///
/// Пришло на смену строке `autoDeductItems` в настройках клиники, которая
/// не умела ни количества, ни привязки к тому, что на приёме собственно
/// делали. Область действия — одна из трёх:
///   always    — расходники каждого приёма (перчатки, маска, слюноотсос);
///   service   — код услуги из прайса (`matchKey` = serviceCode);
///   diagnosis — код МКБ-10 (`matchKey` = код, сравнение по корню).
model StockDeductionRule {
  id       String @id @default(uuid())
  clinicId String

  /// always | service | diagnosis
  scope String @default("always")

  /// Код услуги или диагноза. Для `always` — пустая строка, а не NULL:
  /// иначе уникальный индекс не удержит вторую запись «на каждый приём».
  matchKey String @default("")

  /// Понятное имя правила для списка настроек.
  label String?

  active Boolean @default(true)

  clinic Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  items  StockDeductionRuleItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([clinicId, scope, matchKey])
  @@index([clinicId, active])
  @@map("stock_deduction_rules")
}

/// Строка правила: сколько единиц конкретной позиции склада уходит.
model StockDeductionRuleItem {
  id       String @id @default(uuid())
  ruleId   String
  itemId   String
  quantity Int    @default(1)

  rule StockDeductionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  item InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([ruleId, itemId])
  @@index([itemId])
  @@map("stock_deduction_rule_items")
}


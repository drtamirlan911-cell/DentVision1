// --- ECOSYSTEM: SUPPLIERS ---

enum SupplierStatus {
  pending
  documents_review
  verified
  official_partner
  suspended
}

enum SupplierKind {
  MANUFACTURER
  DISTRIBUTOR
  SUPPLIER
  BRAND_REPRESENTATIVE
}

model Supplier {
  id            String         @id @default(uuid())
  name          String
  kind          SupplierKind   @default(SUPPLIER)
  bin           String?
  legalAddress  String?
  city          String?
  contactPerson String?
  phone         String?
  email         String?
  status        SupplierStatus @default(pending)

  logo           String?
  description    String?
  commissionRate Int     @default(500) // 5% in bps
  deliveryConfig Json? // delivery settings
  bankDetails    Json? // bank info for payouts
  returnPolicy   String?
  minOrderPrice  Int     @default(0)
  rating         Float?
  reviewCount    Int     @default(0)
  orderCount     Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  products      Product[]
  documents     SupplierDocument[]
  members       SupplierMember[]
  deliveryZones DeliveryZone[]
  orders        Order[]
  promotions    ShopPromotion[]

  @@index([city])
  @@index([status])
  @@index([isActive])
  @@map("suppliers")
}

model SupplierMember {
  id         String   @id @default(uuid())
  userId     String
  supplierId String
  role       String   @default("owner")
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([userId, supplierId])
  @@index([userId])
  @@map("supplier_members")
}

model SupplierDocument {
  id         String  @id @default(uuid())
  supplierId String
  type       String
  url        String
  verified   Boolean @default(false)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([supplierId])
  @@map("supplier_documents")
}

model Product {
  id              String  @id @default(uuid())
  name            String
  brand           String?
  category        String? // kept for backward compat
  categoryId      String? // FK to ShopCategory tree
  price           Int
  oldPrice        Int? // original price for discount display
  stock           Int     @default(0)
  minStock        Int     @default(0)
  description     String?
  imageUrl        String? // main image
  images          Json? // additional images array
  rating          Float?
  reviewCount     Int     @default(0)
  supplierId      String?
  sharedProductId String? @map("shared_product_id") // canonical product id grouping supplier offers
  ownBrand        Boolean @default(false)

  // Rich catalog fields
  sku            String? // Р°СЂС‚РёРєСѓР»
  unit           String? // С€С‚, РєРі, РЅР°Р±РѕСЂ...
  currency       String  @default("KZT")
  tags           Json? // array of tags
  specs          Json? // key-value characteristics
  seoTitle       String?
  seoDescription String?
  videoUrl       String?
  model3dUrl     String? // 3D model for equipment
  weight         Float? // kg for delivery calc

  manufacturer  String?
  country       String?
  expiryDate    DateTime?
  compatibility String? // kept for backward compat

  isActive Boolean @default(true)

  favorites    Favorite[]
  reviews      ShopReview[]
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  shopCategory ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([supplierId])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Order {
  id       String  @id @default(uuid())
  clinicId String? // optional for marketplace-only users
  userId   String
  items    Json // snapshot of order lines
  status   String  @default("pending")
  total    Int
  meta     Json?

  // Marketplace delivery & payment
  deliveryAddress       String?
  deliveryMethod        String? // self_pickup, courier, post
  deliveryCost          Int       @default(0)
  paymentMethod         String? // kaspi_qr, card, cash
  paymentStatus         String    @default("pending")
  recipientName         String?
  recipientPhone        String?
  notes                 String?
  estimatedDeliveryDate DateTime?
  deliveredAt           DateTime?
  supplierId            String?
  cancelledAt           DateTime?
  cancelReason          String?

  clinic   Clinic?      @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reviews  ShopReview[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId])
  @@index([clinicId])
  @@index([supplierId])
  @@index([status])
  @@map("orders")
}

model Favorite {
  id        String @id @default(uuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

// в”Ђв”Ђв”Ђ MARKETPLACE V2: CATEGORIES & SPECS в”Ђв”Ђв”Ђ

model ShopCategory {
  id          String  @id @default(uuid())
  parentId    String?
  name        String
  slug        String  @unique
  icon        String?
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  parent   ShopCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ShopCategory[] @relation("CategoryTree")

  products      Product[]
  specTemplates SpecTemplate[]
  presets       ProductPreset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([parentId])
  @@index([slug])
  @@index([isActive, sortOrder])
  @@map("shop_categories")
}

enum SpecFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model SpecTemplate {
  id         String        @id @default(uuid())
  categoryId String?
  name       String
  type       SpecFieldType @default(TEXT)
  unit       String? // РµРґ. РёР·РјРµСЂРµРЅРёСЏ
  options    Json? // for SELECT/MULTI_SELECT: [{ value, label }]
  required   Boolean       @default(false)
  sortOrder  Int           @default(0)

  category ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([categoryId])
  @@map("spec_templates")
}

// в”Ђв”Ђв”Ђ MARKETPLACE V2: REVIEWS в”Ђв”Ђв”Ђ

model ShopReview {
  id           String  @id @default(uuid())
  productId    String
  userId       String
  clinicId     String?
  orderId      String?
  rating       Int
  pros         String?
  cons         String?
  comment      String?
  images       Json? // array of image URLs
  isApproved   Boolean @default(true)
  helpfulCount Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clinic  Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([productId, userId, orderId])
  @@index([productId, rating])
  @@index([userId])
  @@index([isApproved])
  @@map("shop_reviews")
}

// в”Ђв”Ђв”Ђ MARKETPLACE V2: DELIVERY в”Ђв”Ђв”Ђ

model DeliveryZone {
  id            String  @id @default(uuid())
  supplierId    String
  name          String // e.g. "РђР»РјР°С‚С‹", "РЁС‹РјРєРµРЅС‚"
  cities        Json? // array of city/region names
  cost          Int     @default(0)
  freeFrom      Int? // free delivery from this order amount
  estimatedDays Int? // min delivery days
  isActive      Boolean @default(true)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([supplierId])
  @@map("delivery_zones")
}

// в”Ђв”Ђв”Ђ MARKETPLACE V2: BANNERS & PROMOTIONS в”Ђв”Ђв”Ђ

model ShopBanner {
  id        String    @id @default(uuid())
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  color     String? // background color for text display
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([isActive, sortOrder])
  @@map("shop_banners")
}

model ShopPromotion {
  id              String    @id @default(uuid())
  title           String
  description     String?
  type            String    @default("discount") // discount, flash_sale, bundle
  discountPercent Int?
  discountAmount  Int?
  productIds      Json? // array of product IDs
  categoryIds     Json? // array of category IDs
  supplierId      String?
  minOrderAmount  Int? // minimum order to apply
  usageLimit      Int? // max uses
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([supplierId])
  @@index([isActive, startDate, endDate])
  @@map("shop_promotions")
}

// в”Ђв”Ђв”Ђ MARKETPLACE V2: PRODUCT PRESETS в”Ђв”Ђв”Ђ

model ProductPreset {

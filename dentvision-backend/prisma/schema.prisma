model Dashboard {
  id        String    @id @default(uuid())
  scopeType String    @default("CLINIC")
  scopeId   String
  name      String
  layout    Json
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt


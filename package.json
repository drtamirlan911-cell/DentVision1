{
  "name": "dentvision",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix packages/server",
    "dev:client": "npm run dev --prefix DentVision1",
    "build": "npm run build --prefix DentVision1",
    "build:client": "npm run build --prefix DentVision1",
    "db:generate": "npm run db:generate --prefix packages/server",
    "db:push": "npm run db:push --prefix packages/server",
    "db:migrate": "npm run db:migrate --prefix packages/server",
    "db:studio": "npm run db:studio --prefix packages/server",
    "lint": "npm run lint --prefix DentVision1",
    "typecheck": "npm run typecheck --prefix DentVision1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
